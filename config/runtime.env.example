# Export these variables before starting the robot. This file is not loaded automatically.
export RUBIK_SERIAL_PORT=/dev/ttyUSB0
export RUBIK_SERIAL_BAUDRATE=115200
export RUBIK_ODRIVE_SERIAL_NUMBER=
export RUBIK_CAMERA_1=/dev/video2
export RUBIK_CAMERA_2=/dev/video4
export RUBIK_CAMERA_3=/dev/video6
export RUBIK_CAMERA_4=/dev/video8
